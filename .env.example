# Copy to .env (repo root). Never commit .env.

# Written by ~/Desktop/buildspace/neon: provision rio_health --pooling direct
RIO_HEALTH_DATABASE_URL=

# https://openrouter.ai/keys; set a monthly spend limit on the key
OPENROUTER_API_KEY=
# OpenRouter model ids. Candidates are compared by eval/; the winner goes here.
VISION_MODEL=
RERANK_MODEL=
# Output cap per call, reasoning included; hitting it fails the call with a clear error
OPENROUTER_MAX_TOKENS=8000

# 1 = API serves contracts/fixtures instead of calling the parser, catalog and forecast
RIO_USE_MOCKS=0
PARSE_RATE_LIMIT_PER_HOUR=10
MAX_UPLOAD_MB=5

# Frontend (Vite reads VITE_*)
VITE_API_BASE_URL=http://localhost:8000
