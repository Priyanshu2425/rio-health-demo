# Copy to /etc/cloudflared/config.yml on the EC2 host and fill in the tunnel
# id created by `cloudflared tunnel create rio-api`.
tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

ingress:
  - hostname: rio-api.buildspacelabs.com
    service: http://127.0.0.1:8000
  - service: http_status:404
