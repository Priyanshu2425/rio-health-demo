# Docker Compose only picks up a dockerignore named "<dockerfile>.dockerignore"
# when it sits next to the Dockerfile it applies to (here: deploy/Dockerfile),
# so this file must be named deploy/Dockerfile.dockerignore rather than
# deploy/.dockerignore.

.git
**/.venv
**/__pycache__
frontend/node_modules
frontend/
.env
.env.*
eval/
docs/
graft/
.claude/
# Runtime reads only the database; ETL inputs and fixtures stay out of the image.
data/
contracts/
scripts/
kaggle.json
**/.pytest_cache
**/.ruff_cache
backend/tests/
